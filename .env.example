# Frontend (public values only)
VITE_TONCONNECT_MANIFEST_URL=https://YOUR-DOMAIN/tonconnect-manifest.json
VITE_API_BASE_URL=

# Telegram bot / backend (server-side only — never use VITE_ prefix)
BOT_TOKEN=
TELEGRAM_BOT_TOKEN=
MINI_APP_URL=https://YOUR-MINI-APP-DOMAIN
API_PORT=8787
DUR_DATABASE_PATH=./data/dur.sqlite
COOKIE_SECURE=true
CORS_ORIGIN=https://YOUR-MINI-APP-DOMAIN

# TON Connect wallet proof (server-side configuration)
TON_APP_DOMAIN=app.example.com
TON_NETWORK_ID=-3
