# Frontend (public values only)
VITE_TONCONNECT_MANIFEST_URL=https://YOUR-DOMAIN/tonconnect-manifest.json
VITE_API_BASE_URL=

# Telegram bot / backend (server-side only — never use VITE_ prefix)
BOT_TOKEN=
TELEGRAM_BOT_TOKEN=
MINI_APP_URL=https://YOUR-MINI-APP-DOMAIN
API_PORT=8787
DUR_DATABASE_PATH=./data/dur.sqlite
COOKIE_SECURE=true
CORS_ORIGIN=https://YOUR-MINI-APP-DOMAIN

# TON Connect wallet proof (server-side configuration)
TON_APP_DOMAIN=app.example.com
TON_NETWORK_ID=-3

# Optional issuer administration credential (server-side only)
DUR_ADMIN_TOKEN=
DUR_PROOF_VERIFIER_BIN=./bin/dur-proof-verifier

# TON Center API v3 (Testnet only; indexed HTTP data is stored as unverified)
TONCENTER_API_URL=https://testnet.toncenter.com/api/v3
TONCENTER_API_KEY=
INDEXER_START_SEQNO=
INDEXER_MAX_BLOCKS=1
