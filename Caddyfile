{$APP_DOMAIN} {
  encode zstd gzip

  handle /v1/* {
    reverse_proxy api:8787 {
      header_up X-Forwarded-For {remote_host}
    }
  }

  handle /healthz {
    reverse_proxy api:8787 {
      header_up X-Forwarded-For {remote_host}
    }
  }

  handle {
    root * /srv
    try_files {path} /index.html
    file_server
  }
}
