{
  "name": "dur-miniapp",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && npm run typecheck:backend && npm run build:sdk && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "bot": "tsx bot/src/index.ts",
    "api": "tsx backend/src/server.ts",
    "test": "node --import tsx --test backend/test/*.test.ts sdk/test/*.test.ts",
    "typecheck:backend": "tsc --noEmit -p tsconfig.backend.json",
    "build:sdk": "tsc -p tsconfig.sdk.json",
    "indexer:sync": "tsx backend/src/indexer/run.ts"
  },
  "dependencies": {
    "@tonconnect/ui-react": "^2.3.0",
    "grammy": "^1.35.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "better-sqlite3": "^11.8.1",
    "dotenv": "^16.4.7",
    "@ton/ton": "^15.3.1",
    "@ton/core": "^0.62.0",
    "ajv": "^8.17.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "tsx": "^4.19.2",
    "typescript": "~5.7.2",
    "vite": "^6.0.7",
    "@types/node": "^22.10.5",
    "@types/better-sqlite3": "^7.6.12"
  },
  "workspaces": [
    "sdk"
  ]
}
